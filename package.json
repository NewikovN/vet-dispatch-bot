{
  "name": "vet-dispatch-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:max": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root.pem tsx watch src/app-max.ts",
    "dev:webhook": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root.pem tsx watch src/app-max-webhook.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start:webhook": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root.pem node dist/app-max-webhook.js",
    "webhook:register": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root.pem tsx scripts/webhook.ts register",
    "webhook:delete": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root.pem tsx scripts/webhook.ts delete",
    "webhook:list": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root.pem tsx scripts/webhook.ts list",
    "seed": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root.pem tsx scripts/seed.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@maxhub/max-bot-api": "^0.2.5",
    "better-sqlite3": "^12.11.1",
    "dotenv": "17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
